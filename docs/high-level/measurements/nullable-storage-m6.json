{
  "metadata": {
    "purpose": "Same-host before/after comparison of split value/validity storage for nullable numeric columns",
    "measured": "2026-10-21",
    "host": "Apple M6 (192.168.0.5, M6.local), 12 cores, macOS 27.0.1, idle apart from system services",
    "rustc": "rustc 1.99.1 (58cf8f9c3 2026-10-13)",
    "base_revision": "61103a1 (Vec<Option<T>> nullable storage)",
    "change": "this commit (values Vec<T> plus Vec<bool> validity for nullable fixed-width numeric columns)",
    "workflow_build": "cargo build --release --example order_workflow --features rayon with RUSTFLAGS='-C target-cpu=native' CFLAGS='-march=native', identical for both trees",
    "workflow_fixture": "fixture.py --rows 1000000; both trees verified every output cell against the SQL oracle (verify stage, 1 and 8 workers) before timing",
    "workflow_command": "/usr/bin/time -l order_workflow FIXTURE WORKERS STAGE 5 native; two rounds, alternating base then change, cases prepare/1, variants/1, variants/8, complete/1, complete/8",
    "microbenchmark_command": "cargo bench --bench table_dto --bench float_sum -- --output-format bencher (Criterion, repository release profile, no target-cpu flag); base measured in two rounds, change in one",
    "notes": "Values are per-invocation medians of 5 samples in ms and whole-process peak RSS in MiB; microbenchmarks are Criterion point estimates in ns",
    "script": "The table session used an unchecked script with the same build flags, verification, stages, rounds and RSS capture. benches/order_workflow/compare_revisions.sh then reproduced the comparison as a validation session (validation_session below)."
  },
