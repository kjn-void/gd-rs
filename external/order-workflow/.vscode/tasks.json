{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GD workflow: configure Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/../../target/order-workflow-vscode/debug",
        "-G",
        "Unix Makefiles",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/../../target/order-workflow-vscode/debug",
          "-G",
          "Visual Studio 17 2022",
          "-A",
          "x64"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "GD workflow: build AoS Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/../../target/order-workflow-vscode/debug",
        "--config",
        "Debug",
        "--target",
        "gd_order_workflow",
        "--parallel",
        "4"
      ],
      "dependsOn": "GD workflow: configure Debug",
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "problemMatcher": [
          "$msCompile"
        ]
      }
    },
    {
      "label": "GD workflow: build AoSoA Debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/../../target/order-workflow-vscode/debug",
        "--config",
        "Debug",
        "--target",
        "gd_order_workflow_simd",
        "--parallel",
        "4"
      ],
      "dependsOn": "GD workflow: configure Debug",
      "problemMatcher": [
        "$gcc"
      ],
      "windows": {
        "problemMatcher": [
          "$msCompile"
        ]
      }
    },
    {
      "label": "GD workflow: verify both Debug variants",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/../../target/order-workflow-vscode/debug",
        "-C",
        "Debug",
        "--output-on-failure"
      ],
      "dependsOn": [
        "GD workflow: build AoS Debug",
        "GD workflow: build AoSoA Debug"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
