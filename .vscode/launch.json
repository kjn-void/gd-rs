          "--bench",
          "arguments",
          "--profile",
          "dev"
        ],
        "filter": {
          "name": "arguments",
          "kind": "bench"
        },
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "--test",
        "${input:benchmarkFilter}"
