  "inputs": [
    {
      "id": "benchmarkFilter",
      "type": "promptString",
      "description": "Criterion benchmark name filter (empty runs all cases once)",
      "default": ""
    },
    {
      "id": "workflowWorkers",
      "type": "pickString",
      "description": "Order-workflow workers",
      "options": [
        "1",
        "2",
        "4",
        "8"
      ],
      "default": "4"
    },
    {
      "id": "workflowStage",
      "type": "pickString",
      "description": "Order-workflow stage",
      "options": [
        "verify",
        "import",
        "prepare",
        "variants",
        "complete"
      ],
      "default": "verify"
    },
    {
      "id": "workflowIndex",
      "type": "pickString",
      "description": "Order-workflow index",
      "options": [
        "native",
        "sorted"
      ],
      "default": "native"
    }
  ]
}
