{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust example: order_workflow",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--locked",
          "--all-features",
          "--example",
          "order_workflow",
          "--profile",
          "dev"
        ],
        "filter": {
          "name": "order_workflow",
          "kind": "example"
        },
        "cwd": "${workspaceFolder}"
      },
      "args": [
        "${workspaceFolder}/target/vscode-rust/order-workflow-small.sqlite",
        "${input:workflowWorkers}",
        "${input:workflowStage}",
        "1",
        "${input:workflowIndex}"
      ],
      "cwd": "${workspaceFolder}",
      "sourceLanguages": [
        "rust"
      ],
      "terminal": "integrated",
      "preLaunchTask": "Rust: prepare order-workflow fixture"
    },
    {
      "name": "Rust benchmark: arguments",
      "type": "lldb",
      "request": "launch",
